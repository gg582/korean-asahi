+/* Command written into generated .desktop files to start Wine. Setups that
+ * start Wine through a wrapper (e.g. an emulator such as box64) set
+ * WINEMENUBUILDER_LOADER so the menu entries go through it as well. */
+static const char *wine_loader(void)
+{
+    const char *loader = getenv("WINEMENUBUILDER_LOADER");
+    return (loader && *loader) ? loader : "wine";
+}
